# PennyCore — local secrets template. Safe to commit (no real keys).
# Copy this file to `.env` and fill in real keys. `.env` is git-ignored.

# Which provider the main system uses: anthropic | azure | openai | mock
LLM_PROVIDER=anthropic

# ----------------------------------------------------------------------------
# Anthropic Claude (recommended primary — used for system + LLM-as-judge)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-REPLACE-WITH-YOUR-KEY

# ----------------------------------------------------------------------------
# Azure AI Foundry (the "models" endpoint — multi-provider inference).
# Used by the takehome adapter to satisfy the external "OpenAI API"
# requirement, and selectable for the main system via LLM_PROVIDER=azure.
#
# Endpoint pattern: https://<resource>.services.ai.azure.com/models
# Models: any deployment available on your AI Foundry resource — e.g.
# "Kimi-K2.6", "gpt-4o-mini", "DeepSeek-V3", "Mistral-Large-2407".
# ----------------------------------------------------------------------------
AZURE_API_KEY=REPLACE-WITH-YOUR-KEY
AZURE_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/models
AZURE_API_VERSION=2024-05-01-preview
LLM_MODEL=Kimi-K2.6

# Legacy Azure OpenAI naming (classic *.openai.azure.com endpoints). The
# dispatch layer accepts EITHER AZURE_API_KEY/ENDPOINT or these AZURE_OPENAI_*
# names, so existing setups keep working. Leave commented unless you're using
# a classic Azure OpenAI Service deployment instead of AI Foundry Models.
# AZURE_OPENAI_API_KEY=REPLACE-WITH-YOUR-KEY
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
# AZURE_OPENAI_API_VERSION=2024-10-21

# ----------------------------------------------------------------------------
# Standard OpenAI (alternative to Azure for the main system)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-REPLACE-WITH-YOUR-KEY

# Force mock mode regardless of keys (useful for offline work / cost control)
MOCK_LLM=false

# ----------------------------------------------------------------------------
# Datastores (docker-compose defaults — safe to keep as-is for local dev)
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pennycore
POSTGRES_USER=pennycore
POSTGRES_PASSWORD=pennycore_local_dev

REDIS_HOST=localhost
REDIS_PORT=6379
