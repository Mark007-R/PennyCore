# PennyCore — production .env template (Day 29, Phase 6).
#
# Copy this file to `.env.prod`, fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# `.env.prod` is git-ignored (see .gitignore §Secrets). This template is
# committed so a fresh deploy host knows which vars need values.
#
# `scripts/deploy_fly.sh` reads this same shape — anything added here
# MUST be added to that script's `fly secrets set` list too, otherwise
# the deployed app gets a partial config.

# ---------------------------------------------------------------------------
# Build metadata. Overridden at `docker build` time by the deploy script —
# the defaults exist so `docker compose build` succeeds without git context.
# ---------------------------------------------------------------------------
GIT_SHA=unknown
BUILD_DATE=unknown
IMAGE_VERSION=0.2.0

# ---------------------------------------------------------------------------
# Postgres. POSTGRES_PASSWORD is REQUIRED — the compose file fails fast
# with a clear error if it's missing (`:?` syntax).
# ---------------------------------------------------------------------------
POSTGRES_DB=pennycore
POSTGRES_USER=pennycore
POSTGRES_PASSWORD=REPLACE-WITH-STRONG-RANDOM-32-CHARS

# ---------------------------------------------------------------------------
# App URLs — the compose file synthesizes sensible defaults from the
# Postgres vars above; only override these if pointing at a managed DB
# (fly Postgres, Supabase, etc).
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB
# REDIS_URL=redis://HOST:6379/0

# ---------------------------------------------------------------------------
# LLM provider. `mock` is the safe default — the system runs end-to-end
# without burning API budget. Flip to `anthropic` (recommended) or
# `azure` once the key below is filled in.
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock
MOCK_LLM=false

# Anthropic (recommended primary).
ANTHROPIC_API_KEY=

# Azure AI Foundry Models (used by the takehome adapter only).
AZURE_API_KEY=
AZURE_ENDPOINT=
AZURE_API_VERSION=2024-05-01-preview
LLM_MODEL=Kimi-K2.6

# Standard OpenAI (alternative).
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Worker counts. The prod compose file picks 2 / 3 by default. Bump on
# beefier hosts. fly.io 1x machine: keep at defaults. fly.io 4x machine:
# 4 / 6 is a sensible starting point.
# ---------------------------------------------------------------------------
CONTEXT_ENGINE_WORKERS=2
ORCHESTRATOR_WORKERS=3

# Port mappings on the host. Containerised services always listen on
# 8000 internally; the prod compose maps them to these on the host.
CONTEXT_ENGINE_PORT=8001
ORCHESTRATOR_PORT=8002
