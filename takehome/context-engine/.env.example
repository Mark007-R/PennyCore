# Takehome adapter (context-engine) — Azure config template.
# Copy to `.env` and fill in real values. `.env` here is git-ignored
# (see project root .gitignore: `takehome/*/.env`).
#
# The takehome adapter is locked to LLM_PROVIDER=azure to satisfy the
# external spec's "OpenAI API" requirement, regardless of what the
# main PennyCore system uses.
#
# Default shape: Azure AI Foundry "Models" endpoint (multi-provider
# inference, OpenAI-compatible REST shape). Endpoint pattern:
#   https://<resource>.services.ai.azure.com/models
# LLM_MODEL is the deployment name on your AI Foundry resource — e.g.
# "Kimi-K2.6", "gpt-4o-mini", "DeepSeek-V3", "Mistral-Large-2407".

LLM_PROVIDER=azure
AZURE_API_KEY=REPLACE-WITH-YOUR-KEY
AZURE_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/models
AZURE_API_VERSION=2024-05-01-preview
LLM_MODEL=Kimi-K2.6

# Legacy Azure OpenAI naming (classic *.openai.azure.com endpoints).
# The dispatch layer accepts EITHER set. Leave commented unless you're
# using a classic Azure OpenAI Service deployment.
# AZURE_OPENAI_API_KEY=REPLACE-WITH-YOUR-KEY
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
# AZURE_OPENAI_API_VERSION=2024-10-21

# Fallback for environments that prefer the standard OpenAI client (the
# upstream takehome `.env.example` only lists this one).
OPENAI_API_KEY=sk-proj-REPLACE-WITH-YOUR-KEY
