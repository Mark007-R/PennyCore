# Takehome adapter (context-engine) — Azure OpenAI config template.
# Copy to `.env` and fill in real values. `.env` here is git-ignored
# (see project root .gitignore: `takehome/*/.env`).
#
# The takehome adapter is locked to LLM_PROVIDER=azure to satisfy the
# external spec's "OpenAI API" requirement, regardless of what the
# main PennyCore system uses.

LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=REPLACE-WITH-YOUR-KEY
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
AZURE_OPENAI_API_VERSION=2024-10-21

# Fallback for environments that prefer the standard OpenAI client (the
# upstream takehome `.env.example` only lists this one). Either path works
# as long as the adapter can construct an OpenAI-compatible client.
OPENAI_API_KEY=sk-proj-REPLACE-WITH-YOUR-KEY
