# Takehome adapter (orchestrator) — Azure config template.
# Copy to `.env` and fill in real values. `.env` here is git-ignored.
#
# Locked to LLM_PROVIDER=azure to satisfy the external "OpenAI API"
# requirement.
#
# Default shape: Azure AI Foundry "Models" endpoint (multi-provider
# inference, OpenAI-compatible REST shape).

LLM_PROVIDER=azure
AZURE_API_KEY=REPLACE-WITH-YOUR-KEY
AZURE_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/models
AZURE_API_VERSION=2024-05-01-preview
LLM_MODEL=Kimi-K2.6

# Legacy Azure OpenAI naming (classic *.openai.azure.com endpoints).
# The dispatch layer accepts EITHER set.
# AZURE_OPENAI_API_KEY=REPLACE-WITH-YOUR-KEY
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
# AZURE_OPENAI_API_VERSION=2024-10-21

# Fallback (matches upstream takehome `.env.example`).
OPENAI_API_KEY=sk-proj-REPLACE-WITH-YOUR-KEY
